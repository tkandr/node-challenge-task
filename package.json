{
  "name": "token-price-service",
  "version": "1.0.0",
  "description": "A token price service with intentional anti-patterns and bugs for educational purposes",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --no-watchman",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --all --verbose --runInBand --no-watchman --config ./test/e2e/jest-e2e.config.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "keywords": [
    "nestjs",
    "typescript",
    "kafka",
    "postgresql",
    "typeorm"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/basic-auth": "6.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/otel": "0.11.0",
    "@fastify/static": "8.3.0",
    "@knaadh/nestjs-drizzle-postgres": "1.2.0",
    "@nestjs-modules/ioredis": "2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "11.1.6",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/terminus": "11.0.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.66.0",
    "@opentelemetry/context-async-hooks": "2.2.0",
    "@opentelemetry/core": "2.2.0",
    "@opentelemetry/exporter-prometheus": "0.207.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.207.0",
    "@opentelemetry/instrumentation": "0.207.0",
    "@opentelemetry/instrumentation-http": "0.207.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-node": "0.207.0",
    "@opentelemetry/sdk-trace-node": "2.2.0",
    "@opentelemetry/semantic-conventions": "1.37.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.44.6",
    "drizzle-zod": "0.8.3",
    "env-var": "7.5.0",
    "express-basic-auth": "1.2.1",
    "helmet": "8.1.0",
    "kafkajs": "^2.2.4",
    "pg": "8.16.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "7.8.2",
    "uuidv7": "1.0.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/eslintrc": "^3.2.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/kafka": "11.7.1",
    "@testcontainers/postgresql": "11.7.1",
    "@testcontainers/redis": "11.7.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "drizzle-kit": "0.31.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "16.1.0",
    "node-fetch": "3.3.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "npm run lint:fix",
      "npm run format"
    ]
  }
}
