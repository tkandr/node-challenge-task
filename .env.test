# Docker Compose Configuration
COMPOSE_PG_VERSION=18-alpine
COMPOSE_PG_IMAGE=postgres

# Application Configuration
NODE_ENV=test
PORT=3000
HOST=localhost
METRICS_PORT=9323
API_PREFIX=api
SWAGGER_ROUTE=docs

# PostgreSQL Configuration (Testcontainers will override these)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USERNAME=postgres
PG_PASSWORD=postgres
PG_DATABASE=tokens

# Redis Configuration (Testcontainers will override these)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Kafka Configuration (Testcontainers will override these)
KAFKA_CLIENT_ID=token-price-service-test
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=token-price-updates
KAFKAJS_NO_PARTITIONER_WARNING=1

# Cron Configuration - Disable auto-execution in tests
# Run once a year on Dec 31st at midnight to effectively disable during tests
PRICE_UPDATE_CRON_SCHEDULE="0 0 31 12 *"
OUTBOX_PROCESSOR_CRON_SCHEDULE="0 0 31 12 *"
